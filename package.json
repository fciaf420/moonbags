{
  "name": "memeautobuy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "tsx src/_setup.ts",
    "doctor": "tsx src/_doctor.ts",
    "install:onchainos": "curl -sSL https://raw.githubusercontent.com/okx/onchainos-skills/main/install.sh | sh",
    "dev": "node --dns-result-order=ipv4first --import tsx --watch src/main.ts",
    "start": "node --dns-result-order=ipv4first --import tsx src/main.ts",
    "private-feed:relay": "APP_ROLE=private-signal-relay node --dns-result-order=ipv4first --import tsx src/privateSignalRelay.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.0",
    "@types/pg": "^8.20.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^11.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
